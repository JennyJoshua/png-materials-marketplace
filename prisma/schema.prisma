// PNG Materials Marketplace - Phase 1 (Foundation) schema.
//
// Marketplace foundation and provider models. Later phases add their own additive models and migrations.
//
// Authentication lives in Supabase Auth (the Supabase-managed `auth` schema). This schema stores
// application/profile data only: there is NO password column and NO foreign key to the `auth` schema.
// `users.id` holds the Supabase Auth user UUID.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime connection: Supabase pooled connection (port 6543, ?pgbouncer=true).
  url       = env("DATABASE_URL")
  // Migrations / direct operations: direct or session-pooler connection (port 5432).
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CUSTOMER
  SUPPLIER
  ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  SUSPENDED
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum ProviderKind {
  INDIVIDUAL
  BUSINESS
}

enum ProviderType {
  PRODUCTS
  SERVICES
  BOTH
}

enum ProviderStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
}

enum ProviderVerificationLevel {
  UNVERIFIED
  CONTACT_CONFIRMED
  DOCUMENTS_CHECKED
}

enum ProductStockStatus {
  IN_STOCK
  LIMITED_STOCK
  OUT_OF_STOCK
  CONTACT_SUPPLIER
}

enum ProductListingStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum EnquiryType {
  PRODUCT
  SERVICE
}

enum EnquiryStatus {
  SUBMITTED
  VIEWED
  IN_DISCUSSION
  QUOTATION_SENT
  CLOSED
  DECLINED
  CANCELLED
}

enum EnquiryMessageSenderType {
  VISITOR
  PROVIDER
  SYSTEM
}

/// Application user record. `id` = Supabase Auth user UUID (supplied by the application, no DB default).
/// `role` here is the AUTHORITATIVE application role.
model User {
  id          String     @id @db.Uuid
  role        UserRole   @default(CUSTOMER)
  fullName    String     @map("full_name")
  email       String     @unique
  phone       String?
  status      UserStatus @default(PENDING)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastLoginAt DateTime?  @map("last_login_at") @db.Timestamptz(6)

  customerProfile CustomerProfile?
  supplierProfile SupplierProfile?
  auditLogs       AuditLog[]
  providerProfile ProviderProfile?
  verifiedProviders ProviderProfile[] @relation("ProviderVerifier")
  enquiryMessages EnquiryMessage[]

  @@index([role])
  @@index([status])
  @@map("users")
}

model CustomerProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  address   String?
  location  String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

model SupplierProfile {
  id                  String             @id @default(uuid()) @db.Uuid
  userId              String             @unique @map("user_id") @db.Uuid
  businessName        String             @map("business_name")
  businessDescription String?            @map("business_description")
  businessAddress     String             @map("business_address")
  location            String
  phone               String?
  email               String?
  logoUrl             String?            @map("logo_url")
  verificationStatus  VerificationStatus @default(PENDING) @map("verification_status")
  deliveryAvailable   Boolean            @default(false) @map("delivery_available")
  pickupAvailable     Boolean            @default(true) @map("pickup_available")
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([verificationStatus])
  @@index([location])
  @@index([businessName])
  @@map("supplier_profiles")
}

model ProductCategory {
  id          String         @id @default(uuid()) @db.Uuid
  name        String         @unique
  description String?
  status      CategoryStatus @default(ACTIVE)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  listings ProductListing[]

  @@map("product_categories")
}

/// Security-relevant event log. Never store passwords, tokens or other secrets in `metadata`.
model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  action       String
  resourceType String?  @map("resource_type")
  resourceId   String?  @map("resource_id")
  metadata     Json?
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model ProviderProfile {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  displayName String @map("display_name") @db.VarChar(120)
  providerKind ProviderKind @map("provider_kind")
  providerType ProviderType @map("provider_type")
  description String? @db.VarChar(2000)
  phone String? @db.VarChar(40)
  publicEmail String? @map("public_email") @db.VarChar(254)
  address String? @db.VarChar(300)
  province String @db.VarChar(100)
  district String? @db.VarChar(100)
  townOrArea String? @map("town_or_area") @db.VarChar(120)
  businessRegistrationNumber String? @map("business_registration_number") @db.VarChar(100)
  websiteUrl String? @map("website_url") @db.VarChar(500)
  logoUrl String? @map("logo_url") @db.VarChar(500)
  deliveryAvailable Boolean @default(false) @map("delivery_available")
  pickupAvailable Boolean @default(false) @map("pickup_available")
  status ProviderStatus @default(DRAFT)
  verificationLevel ProviderVerificationLevel @default(UNVERIFIED) @map("verification_level")
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  verifiedByUserId String? @map("verified_by_user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy User? @relation("ProviderVerifier", fields: [verifiedByUserId], references: [id], onDelete: Restrict)
  productListings ProductListing[]
  enquiries Enquiry[]
  @@index([status, createdAt])
  @@index([verifiedByUserId])
  @@index([verificationLevel])
  @@index([province, district])
  @@index([displayName])
  @@map("provider_profiles")
}

model ServiceCategory {
  id String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(120)
  description String? @db.VarChar(500)
  status CategoryStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  enquiries Enquiry[]
  @@map("service_categories")
}

/// Provider-owned product offer. Public visibility is enforced in server queries:
/// listing ACTIVE + provider ACTIVE + category ACTIVE. All access uses server Prisma.
model ProductListing {
  id             String               @id @default(uuid()) @db.Uuid
  providerProfileId String             @map("provider_profile_id") @db.Uuid
  categoryId     String               @map("category_id") @db.Uuid
  name           String               @db.VarChar(160)
  brand          String?              @db.VarChar(120)
  specification  String?              @db.VarChar(500)
  description    String?
  unit           String               @db.VarChar(40)
  price          Decimal              @db.Decimal(12, 2)
  stockStatus    ProductStockStatus   @default(CONTACT_SUPPLIER) @map("stock_status")
  listingStatus  ProductListingStatus @default(DRAFT) @map("listing_status")
  priceUpdatedAt DateTime             @default(now()) @map("price_updated_at") @db.Timestamptz(6)
  stockUpdatedAt DateTime             @default(now()) @map("stock_updated_at") @db.Timestamptz(6)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  providerProfile ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Restrict)
  category        ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  enquiries       Enquiry[]

  @@unique([id, providerProfileId])
  @@index([providerProfileId, listingStatus])
  @@index([categoryId, listingStatus])
  @@index([listingStatus, updatedAt])
  @@index([price])
  @@index([name])
  @@map("product_listings")
}

/// Guest-first enquiry header. Every enquiry is routed to exactly one provider.
model Enquiry {
  id                String       @id @default(uuid()) @db.Uuid
  publicReference   String       @unique @map("public_reference") @db.VarChar(24)
  type              EnquiryType
  providerProfileId String       @map("provider_profile_id") @db.Uuid
  productListingId  String?      @map("product_listing_id") @db.Uuid
  serviceCategoryId String?      @map("service_category_id") @db.Uuid
  visitorName       String       @map("visitor_name") @db.VarChar(120)
  visitorEmail      String       @map("visitor_email") @db.VarChar(254)
  visitorPhone      String       @map("visitor_phone") @db.VarChar(40)
  subject           String       @db.VarChar(160)
  summary           String       @db.VarChar(4000)
  status            EnquiryStatus @default(SUBMITTED)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastActivityAt    DateTime     @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  closedAt          DateTime?    @map("closed_at") @db.Timestamptz(6)

  providerProfile ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Restrict)
  productListing  ProductListing? @relation(fields: [productListingId, providerProfileId], references: [id, providerProfileId], onDelete: Restrict)
  serviceCategory ServiceCategory? @relation(fields: [serviceCategoryId], references: [id], onDelete: Restrict)
  messages        EnquiryMessage[]
  accessCredentials EnquiryAccessCredential[]

  @@index([providerProfileId, status, lastActivityAt])
  @@index([type, createdAt])
  @@index([createdAt])
  @@map("enquiries")
}

/// Conversation entries are separate from the enquiry summary; the initial visitor message
/// is stored here exactly once. Message edits are not part of this phase.
model EnquiryMessage {
  id           String                   @id @default(uuid()) @db.Uuid
  enquiryId    String                   @map("enquiry_id") @db.Uuid
  senderType   EnquiryMessageSenderType  @map("sender_type")
  senderUserId String?                  @map("sender_user_id") @db.Uuid
  body         String                   @db.VarChar(4000)
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  enquiry   Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  senderUser User?  @relation(fields: [senderUserId], references: [id], onDelete: Restrict)

  @@index([enquiryId, createdAt])
  @@index([senderUserId])
  @@map("enquiry_messages")
}

/// Only a SHA-256 digest is persisted. The raw visitor capability is returned once by the
/// credential-issuing service and must never be written to logs or audit metadata.
model EnquiryAccessCredential {
  id         String    @id @default(uuid()) @db.Uuid
  enquiryId  String    @map("enquiry_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@index([enquiryId, expiresAt])
  @@map("enquiry_access_credentials")
}
