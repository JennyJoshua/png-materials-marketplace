# Copy to .env (Prisma and Next.js both read it) and NEVER commit the real file.
# .env, .env.local and .env.*.local are git-ignored. This file holds names only.
# On Render, set these in the service's Environment settings instead.

# --- Supabase PostgreSQL (used by Prisma) ---------------------------------------------------
# Runtime connection: Supabase "Transaction pooler" string (port 6543). Keep ?pgbouncer=true.
DATABASE_URL=
# Migrations / direct operations: "Direct connection" (port 5432), or the "Session pooler"
# string if your network cannot reach the IPv6-only direct host.
DIRECT_URL=

# --- Supabase Auth (public values, safe for the browser) -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase service role (SECRET, server-only) ---------------------------------------------
# Bypasses RLS. Used only at registration to record the trusted registration type in
# app_metadata. Never expose it to the browser or prefix it NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional -------------------------------------------------------------------------------
# Public address of the site. Set it on any hosted service that sits behind a proxy (such as
# Render): it decides where users land after confirming their e-mail. Without it the app falls
# back to the server's internal address (for example http://localhost:10000), which is wrong for
# visitors. Use a full https:// address; only the scheme, host and port are used. When it is set
# while the app is BUILT, that value is built in, so set it before deploying.
# NEXT_PUBLIC_SITE_URL=https://your-app.onrender.com
